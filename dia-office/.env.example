# ---- Server ----
PORT=8080
PUBLIC_URL=http://localhost:8080
# Long random string. Needed to approve hires/projects and add leads from the office page.
# `npm run setup` fills this in for you. The placeholder below is rejected.
ADMIN_TOKEN=change-me-to-a-long-random-string

# ---- Database (Postgres with pgvector) ----
DATABASE_URL=postgres://dia:dia@localhost:5432/dia

# ---- AI provider: mock | ollama | anthropic | bedrock ----
# mock      = no AI, canned answers (to test the flow)
# ollama    = free local models on your machine
# anthropic = Claude through the Anthropic API (key from console.anthropic.com)
# bedrock   = Claude on Amazon Bedrock
LLM_PROVIDER=mock

# Anthropic API. Easiest: run  npm run setup -- anthropic  and paste the key when asked (it stays hidden).
# Never share this key or paste it into a chat.
ANTHROPIC_API_KEY=
# fast = everyday team work, smart = Dia's big decisions
ANTHROPIC_FAST_MODEL=claude-sonnet-5-5
ANTHROPIC_SMART_MODEL=claude-opus-5-5
# How hard each model thinks before answering: low | medium | high. Lower is faster and cheaper.
ANTHROPIC_FAST_EFFORT=low
ANTHROPIC_SMART_EFFORT=medium
# If Claude declines a request, retry it on another Claude model automatically. Set false to turn off.
ANTHROPIC_FALLBACKS=true

# Ollama (local, free). Easiest: npm run setup -- ollama   (picks models that fit your PC), then npm run ollama:pull
# fast = team work and chat (Gemma is the best local model for Hindi/Marathi), smart = Dia's decisions (thinks first),
# code = websites and code fixes, embed = knowledge search in 100+ languages.
OLLAMA_URL=http://localhost:11434
OLLAMA_FAST_MODEL=gemma3:12b
OLLAMA_SMART_MODEL=gpt-oss:20b
OLLAMA_CODE_MODEL=qwen2.5-coder:14b
OLLAMA_EMBED_MODEL=qwen3-embedding:0.6b
# How much text a model reads at once. Ollama's own default (4K) silently cuts long prompts. More needs more memory.
OLLAMA_NUM_CTX=16384
# Let the smart and code models think before answering (better, slower). Set false on a slow PC.
OLLAMA_THINK=true
# How long a model stays loaded after use, so the next step starts fast.
OLLAMA_KEEP_ALIVE=30m

# Bedrock (copy the eu./apac./global. inference profile IDs from the Bedrock model catalog)
AWS_REGION=ap-south-1
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
BEDROCK_FAST_MODEL_ID=paste-claude-haiku-inference-profile-id
BEDROCK_SMART_MODEL_ID=paste-claude-sonnet-inference-profile-id
BEDROCK_EMBED_MODEL_ID=amazon.titan-embed-text-v2:0
BEDROCK_PROMPT_CACHE=false

# Embedding size: 768 works for qwen3-embedding (any size) and nomic-embed-text, 1024 for Titan v2. Set BEFORE first migrate.
# Switching provider later is fine: the knowledge base re-embeds its documents on the next start.
# (The Anthropic API has no embeddings, so with LLM_PROVIDER=anthropic search uses a free built-in word match.)
EMBED_DIM=768

# Prices in USD per million tokens (for the AI-spend counter). Defaults are Anthropic API prices for
# Sonnet 5.5 (fast) and Opus 5.5 (smart). For Bedrock, check the Bedrock price page.
PRICE_FAST_IN=2
PRICE_FAST_OUT=10
PRICE_SMART_IN=4
PRICE_SMART_OUT=20

# Safety cap: Dia pauses AI calls when this month's spend passes this (USD).
MONTHLY_AI_BUDGET_USD=25
# Rupees per US dollar, used to show AI spend in the profit view.
USD_INR=84

# ---- Dia's code fixes (optional) ----
# When you approve a fix Dia drafted, she opens a pull request here. Use a fine-grained token with
# "Contents" and "Pull requests" read/write on this repo only. Without it, fixes are saved to fixes/.
GITHUB_TOKEN=
GITHUB_REPO=vaibhavpetkar/dia-office
GITHUB_PATH_PREFIX=dia-office/

# ---- Email (Amazon SES). Leave SES_FROM empty to only log emails. ----
SES_FROM=
HR_CC=
COMPANY_NAME=Inveon Technologies

# Dia's voice. Leave empty to use the browser's voices (free; Microsoft Edge has natural
# English, Hindi and Marathi voices). With an Azure Speech key every browser gets the neural
# Neerja / Swara / Aarohi voices and Dia's lips follow the real audio. Free tier: 0.5M characters a month.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=centralindia

# Seconds-long waits are normal when a free Neon/Supabase database wakes up.
DB_CONNECT_TIMEOUT_MS=20000

# ---- Pictures for jobs: mock | local | bedrock ----
# mock draws a simple test poster for free. local uses Stable Diffusion on your own PC, free: install
# Stable Diffusion WebUI Forge, add "--api" to its start options, and load a model such as SDXL.
# bedrock uses Amazon Nova Canvas (about $0.04 a picture, counted in the AI budget).
# Nova Canvas is offered in us-east-1, eu-west-1 and ap-northeast-1 only.
IMAGE_PROVIDER=mock
SD_URL=http://127.0.0.1:7860
SD_STEPS=25
IMAGE_AWS_REGION=us-east-1
BEDROCK_IMAGE_MODEL_ID=amazon.nova-canvas-v1:0
PRICE_IMAGE=0.04

# ---- App API (/api/v1) ----
# Websites on other domains that may call the API from a browser, comma separated. Phone and desktop apps don't need this.
CORS_ORIGINS=
