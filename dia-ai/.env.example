# Copy this file to .env and fill in the values.
AWS_REGION=us-east-1
# Claude models on Bedrock (Messages API endpoint). Use the "anthropic." IDs, not "us." ones.
DIA_CEO_MODEL_ID=anthropic.claude-opus-5-5
DIA_WORKER_MODEL_ID=anthropic.claude-sonnet-5-5
# Image model for the Creative Manager (enable it in Bedrock -> Model catalog).
DIA_IMAGE_MODEL_ID=amazon.nova-canvas-v1:0
