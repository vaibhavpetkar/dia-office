# Copy this file to .env and fill in the values. Never share .env or paste the key in a chat.

# Where the AI runs: anthropic (API key from console.anthropic.com), bedrock (Amazon Bedrock),
# or ollama (free local models on this PC; see the ollama lines below)
DIA_PROVIDER=anthropic
ANTHROPIC_API_KEY=paste-your-key-here

# CEO = strongest model, workers = faster/cheaper one. Plain IDs work for both Claude providers.
DIA_CEO_MODEL_ID=claude-opus-5-5
DIA_WORKER_MODEL_ID=claude-sonnet-5-5
# For DIA_PROVIDER=ollama use local models that can call tools, for example (16 GB+ memory):
#   DIA_CEO_MODEL_ID=gpt-oss:20b
#   DIA_WORKER_MODEL_ID=qwen3:8b
# then download them once:  ollama pull gpt-oss:20b  and  ollama pull qwen3:8b
OLLAMA_URL=http://localhost:11434
OLLAMA_NUM_CTX=16384

# Pictures for the Creative Manager: off, local or bedrock. With "off" the team writes an image brief instead.
# local = Stable Diffusion WebUI Forge on this PC, started with --api (free). bedrock = Amazon Nova Canvas.
DIA_IMAGE_PROVIDER=off
DIA_IMAGE_MODEL_ID=amazon.nova-canvas-v1:0
SD_URL=http://127.0.0.1:7860

# Only for DIA_PROVIDER=bedrock or DIA_IMAGE_PROVIDER=bedrock (log in with: aws configure)
AWS_REGION=us-east-1
