# Copy this file to .env and fill in the values. Never share .env or paste the key in a chat.

# Where the AI runs: anthropic (API key from console.anthropic.com), bedrock (Amazon Bedrock),
# or openrouter (one key from openrouter.ai/keys for Claude, GPT, Gemini, DeepSeek... including free models)
DIA_PROVIDER=anthropic
ANTHROPIC_API_KEY=paste-your-key-here

# Only for DIA_PROVIDER=openrouter or DIA_IMAGE_PROVIDER=openrouter. Model IDs are as shown on
# openrouter.ai/models (free ones end in :free); python check_setup.py lists the free ones.
# Free models allow about 50 requests a day in total, about 1,000 a day once you add $10 of credits.
OPENROUTER_API_KEY=
# Up to 2 backups OpenRouter tries when a model is busy or out of free requests (comma separated).
OPENROUTER_FALLBACK_MODELS=

# CEO = strongest model, workers = faster/cheaper one. Plain IDs work for both providers.
# Bedrock inference-profile IDs (au.anthropic..., us.anthropic..., global.anthropic...) are used as-is.
# With openrouter use its names, e.g. anthropic/claude-opus-5.5 and deepseek/deepseek-chat-v3-0324:free
DIA_CEO_MODEL_ID=claude-opus-5-5
DIA_WORKER_MODEL_ID=claude-sonnet-5-5

# Pictures for the Creative Manager: off, openrouter (e.g. Google's Nano Banana, about $0.04 a picture,
# set DIA_IMAGE_MODEL_ID=google/gemini-2.5-flash-image) or bedrock (Amazon Nova Canvas).
# With "off" the team writes an image brief instead of a picture.
DIA_IMAGE_PROVIDER=off
DIA_IMAGE_MODEL_ID=amazon.nova-canvas-v1:0

# Only for DIA_PROVIDER=bedrock or DIA_IMAGE_PROVIDER=bedrock (log in with: aws configure)
AWS_REGION=us-east-1
